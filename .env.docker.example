# Copy to .env before `docker compose up --build`.
# Compose substitutes these into the backend service.

# REQUIRED: long random value used to HMAC API keys.
API_KEY_PEPPER=change-me-to-a-long-random-string

# Optional: creates an admin key on first startup (only if it doesn't exist).
# BOOTSTRAP_ADMIN_KEY=mm_live_replace_me

# slim (sklearn + ONNX) or full (adds XGBoost/LightGBM/CatBoost/TorchScript)
BACKEND_TARGET=slim

# Browser origin allowed to call the API (nginx-served frontend).
CORS_ORIGINS=http://localhost:8080
