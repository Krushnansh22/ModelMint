# --- app ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- database ----------------------------------------------------------
# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./storage/modelmint.db
# Postgres (Compose/prod)
# DATABASE_URL=postgresql+psycopg2://modelmint:modelmint@localhost:5432/modelmint

# --- storage -----------------------------------------------------------
STORAGE_BACKEND=local
MODEL_STORAGE_DIR=storage
# S3 / MinIO (M4)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=modelmint
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# --- security ----------------------------------------------------------
# REQUIRED in production: long random string used to HMAC API keys.
API_KEY_PEPPER=dev-only-change-me
# Optional: creates an admin key on startup if it doesn't exist.
# BOOTSTRAP_ADMIN_KEY=mm_live_replace_me
REQUIRE_AUTH_FOR_PREDICT=true
REQUIRE_AUTH_FOR_READS=false

# --- rate limits -------------------------------------------------------
RATE_LIMIT_PREDICT_PER_MIN=120
RATE_LIMIT_UPLOAD_PER_HOUR=20
# Optional shared limiter (Compose sets this to redis://redis:6379/0)
# REDIS_URL=redis://localhost:6379/0

# --- uploads -----------------------------------------------------------
MAX_UPLOAD_MB=500

# --- model manager / sandbox ------------------------------------------
MAX_RESIDENT_MODELS=5
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT_SECONDS=30
INFERENCE_TIMEOUT_SECONDS=30

# --- CORS --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
